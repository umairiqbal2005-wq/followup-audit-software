# Application
APP_NAME=Audit Observations Platform
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database: oracle | sqlite
DB_BACKEND=sqlite
# Oracle runtime user (least privilege) — never use AOP_OWNER from the app
ORACLE_USER=aop_app
ORACLE_PASSWORD=aop_password
# Easy Connect or TNS alias (prefer TCPS): host:1521/XEPDB1 or host:2484/XEPDB1
ORACLE_DSN=localhost:1521/XEPDB1
# Schema that owns tables; app sets CURRENT_SCHEMA on connect
ORACLE_SCHEMA=AOP_OWNER
ORACLE_EDITION=
# Wallet / TCPS (python-oracledb). Leave empty for password auth over TCP.
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=
ORACLE_CONFIG_DIR=
ORACLE_TCP_CONNECT_TIMEOUT_SEC=10
ORACLE_CALL_TIMEOUT_MS=60000
ORACLE_POOL_SIZE=20
ORACLE_MAX_OVERFLOW=40
ORACLE_POOL_RECYCLE_SEC=1800
ORACLE_POOL_TIMEOUT_SEC=30
ORACLE_DISABLE_OOB=false
# Keep true in production — apply scripts/*.sql instead of create_all
ORACLE_MANAGE_SCHEMA_EXTERNALLY=true
# SQLite (local development without Oracle)
SQLITE_PATH=./aop.db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# LDAP / Active Directory
LDAP_ENABLED=false
LDAP_URL=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=admin
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_USE_SSL=false

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

HEALTH_CHECK_DB=true

    # Dev bootstrap accounts (disabled automatically when APP_ENV=production or LDAP_ENABLED=true)
    # Always re-synced on startup in development:
    #   admin / Admin@123
    #   umair / Umair@123   (project owner admin — can manage roles & regions)
    DISABLE_DEV_BOOTSTRAP=false
    DEV_ADMIN_USERNAME=admin
    DEV_ADMIN_PASSWORD=Admin@123
    DEV_ADMIN_EMAIL=admin@example.com
