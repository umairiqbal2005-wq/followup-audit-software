# Application
APP_NAME=Audit Observations Platform
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database: oracle | sqlite
DB_BACKEND=sqlite
# Oracle (production / docker)
ORACLE_USER=aop_app
ORACLE_PASSWORD=aop_password
ORACLE_DSN=localhost:1521/XEPDB1
# SQLite (local development without Oracle)
SQLITE_PATH=./aop.db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# LDAP / Active Directory
LDAP_ENABLED=false
LDAP_URL=ldap://localhost:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=admin
LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
LDAP_USE_SSL=false

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# Dev bootstrap admin (used when LDAP is disabled)
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=Admin@123
DEV_ADMIN_EMAIL=admin@example.com
